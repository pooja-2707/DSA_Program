class Solution {
    public int countGoodSubstrings(String s) {
        int count=0;
        for(int high=2;high<s.length();high++){
            char a=s.charAt(high-2);
            char b=s.charAt(high-1);
            char c=s.charAt(high);
            if(a!=b && b!=c && c!=a){
                count++;
            }
        }
        return count;
    }
}
